DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
OWNER_PASSWORD="change-me"
VISITOR_PASSWORD="change-me"
ADMIN_PASSWORD="change-me"

# ─── Storage Configuration ───────────────────────────────────────────────
# Required: selects the storage adapter (currently only "r2" is supported)
STORAGE_DRIVER="r2"

# Comma-separated list of exact origins allowed for CORS.
# Wildcards (*) are NOT permitted — the server refuses to start.
STORAGE_ALLOWED_ORIGINS="https://your-app.example.com"

# ─── Cloudflare R2 adapter (required when STORAGE_DRIVER=r2) ─────────────
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="secret-space"

# Legacy migration only — set to old public R2 URL during migration, remove after
# R2_LEGACY_PUBLIC_URL=https://old-public.r2.example.com
